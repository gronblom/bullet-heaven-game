<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless gameplay checks against the shared core: dotnet run in this folder (exit code 1 on failure). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../core/BulletHeaven.Core.csproj" />
  </ItemGroup>
</Project>
