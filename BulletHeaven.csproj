<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>BulletHeaven</RootNamespace>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- All gameplay (Arch ECS, systems, levels) lives in the shared, engine-independent core. -->
    <ProjectReference Include="core/BulletHeaven.Core.csproj" />
    <!-- Other projects in this folder: not part of the Godot assembly. -->
    <Compile Remove="core/**;tests/**;unity/**" />
  </ItemGroup>
</Project>
